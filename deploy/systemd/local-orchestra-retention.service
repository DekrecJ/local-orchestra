[Unit]
Description=Local Orchestra workspace retention

[Service]
Type=oneshot
User=derex
Group=derex
WorkingDirectory=/srv/local-orchestra/apps/orchestrator
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=-/srv/local-orchestra/apps/orchestrator/.env
ExecStart=/srv/local-orchestra/apps/orchestrator/.venv/bin/python -m app.retention
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/srv/local-orchestra/apps/orchestrator
ReadWritePaths=/srv/local-orchestra/workspaces
