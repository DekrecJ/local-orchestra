[Unit]
Description=Local Orchestra Temporal worker (local staging)
After=network.target

[Service]
Type=simple
User=orchestra
Group=orchestra
WorkingDirectory=/srv/local-orchestra/apps/orchestrator
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=-/srv/local-orchestra/apps/orchestrator/.env
ExecStart=/srv/local-orchestra/apps/orchestrator/.venv/bin/python -m app.worker
Restart=on-failure
RestartSec=5
# El worker invoca el launcher exacto permitido por sudoers. El contenedor
# aplica no-new-privileges y elimina todas las capacidades.
NoNewPrivileges=false
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/srv/local-orchestra/apps/orchestrator
ReadWritePaths=/srv/local-orchestra/workspaces
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
