# Configuración no secreta para staging local. No coloque tokens ni contraseñas aquí.
ORCHESTRA_ENVIRONMENT=local-staging
ORCHESTRA_LOG_LEVEL=INFO
ORCHESTRA_LOG_JSON=true
ORCHESTRA_OLLAMA_BASE_URL=http://127.0.0.1:11434
ORCHESTRA_OLLAMA_MODEL=qwen3.5:4b
ORCHESTRA_EMBEDDING_MODEL=qwen3-embedding:0.6b
ORCHESTRA_TEMPORAL_ADDRESS=127.0.0.1:7233
ORCHESTRA_TEMPORAL_NAMESPACE=local-orchestra
ORCHESTRA_TEMPORAL_TASK_QUEUE=local-ai
ORCHESTRA_WORKFLOW_EXECUTION_TIMEOUT_SECONDS=2400
ORCHESTRA_WORKFLOW_RUN_TIMEOUT_SECONDS=2400
ORCHESTRA_API_AUTH_ENABLED=true
ORCHESTRA_HEALTH_CACHE_SECONDS=15
ORCHESTRA_CODEX_ENABLED=false
ORCHESTRA_WORKSPACE_RETENTION_HOURS=168
ORCHESTRA_OBSIDIAN_ENABLED=false
ORCHESTRA_OBSIDIAN_VAULT_PATH=/home/derex/Capsulas/Obsidian/Orchestra-Vault
ORCHESTRA_OBSIDIAN_MAX_NOTE_BYTES=262144
ORCHESTRA_OBSIDIAN_MAX_REPORT_BYTES=262144
ORCHESTRA_OBSIDIAN_MAX_SEARCH_NOTES=500
ORCHESTRA_OBSIDIAN_MAX_SEARCH_RESULTS=20
ORCHESTRA_OBSIDIAN_CONTEXT_MAX_BYTES=32768

# Los secretos se referencian mediante archivos locales fuera del control de versiones.
ORCHESTRA_POSTGRES_PASSWORD_FILE=/srv/local-orchestra/apps/orchestrator/.secrets/postgres_password
ORCHESTRA_API_TOKEN_FILE=/srv/local-orchestra/apps/orchestrator/.secrets/api_token
